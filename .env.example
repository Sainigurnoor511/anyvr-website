# Copy to .env.local and fill in; FISH_ variables stay on the server and never reach the browser.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# Optional voice overrides by style and language, e.g. FISH_VOICE_STORY_EN; sensible defaults are built in.
FISH_VOICE_STORY_EN=
FISH_VOICE_HISTORY_EN=
FISH_VOICE_FRIEND_EN=

# Waitlist: entries are saved to WAITLIST_FILE (default data/waitlist.json) unless a webhook is set, e.g. a Google Apps Script, Zapier or Make URL.
WAITLIST_FILE=
WAITLIST_WEBHOOK_URL=
